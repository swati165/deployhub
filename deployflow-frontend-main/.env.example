# PostgreSQL database. Create the database before starting the API.
DATABASE_URL=postgresql://deployhub:local_dev_only@localhost:5432/deployhub
DATABASE_SSL=false

# Replace with a random secret of at least 32 bytes.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Vite browser API endpoint.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=DeployHub
APP_DOMAIN=localhost

# The local isolated runtime is experimental; keep disabled by default.
EXECUTION_PROVIDER=disabled
ISOLATED_EXECUTOR_ENABLED=false
ISOLATED_EXECUTOR_IMAGE=

# Optional trusted-worker source pinning. The token is used only to resolve
# public GitHub branch refs and is never passed to an execution provider.
SOURCE_RESOLVER=disabled
GITHUB_SOURCE_TOKEN=

# Registry publishing is a separate trusted-worker capability and remains off.
REGISTRY_PUSH_ENABLED=false
REGISTRY_PROVIDER=disabled
REGISTRY_HOST=
REGISTRY_REPOSITORY=
REGISTRY_TAGS_IMMUTABLE=false
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
