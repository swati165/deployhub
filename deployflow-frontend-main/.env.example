# PostgreSQL database. Create the database before starting the API.
DATABASE_URL=postgresql://deployhub:local_dev_only@localhost:5432/deployhub
DATABASE_SSL=false

# Replace with a random secret of at least 32 bytes.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Vite browser API endpoint.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=DeployHub

# Deployment execution is intentionally disabled unless all required values
# are configured on a dedicated isolated deployment worker.
# DEPLOYMENT_EXECUTOR=isolated-docker
# BUILD_RUNNER_ISOLATED=true
# DOCKER_REGISTRY=registry.example.com
# KUBE_NAMESPACE=deployhub
# DEPLOYMENT_DOMAIN=apps.example.com
# KUBE_TLS_SECRET=deployhub-tls
# DEPLOYMENT_HEALTH_PATH=/
# KUBECONFIG=/secure/path/to/kubeconfig
