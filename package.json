{
  "name": "deployhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "lint": "oxlint",
    "preview": "vite preview --config frontend/vite.config.js",
    "server": "node backend/index.js",
    "worker": "node orchestration/worker.js",
    "migrate": "node database/migrate.js",
    "test": "npm run test:backend && npm run test:orchestration && npm run test:database",
    "test:server": "npm test",
    "test:backend": "node --test backend/*.test.js",
    "test:orchestration": "node --test orchestration/*.test.js orchestration/executors/*.test.js",
    "test:database": "node --test database/*.test.js",
    "backend:up": "docker compose -f docker/compose.yaml up --build -d db api worker",
    "backend:down": "docker compose -f docker/compose.yaml stop worker api db",
    "app:up": "docker compose -f docker/compose.yaml up --build -d db api worker caddy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.26.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
